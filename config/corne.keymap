/*
 * Corne (crkbd) ZMK keymap — 36-key (3x5+3)
 * Converted from QMK/Vial export "crkbd.layout.json"
 *
 * The official ZMK `corne` shield has a 42-key matrix (3x6+3). The outer
 * pinky positions exist in the matrix but have no switches on this board,
 * so they stay &none — do not delete them.
 *
 * Layers:
 *   0 QWERTY   base
 *   1 SYM_NAV  numbers / symbols / arrows   (hold the LEFT  SPACE thumb -> < 1)
 *   2 FUNC     F-keys / symbols / edit / mac shortcuts (hold RIGHT ENTER thumb -> < 2)
 *   3 COLEMAK  alternate base (jump in with &to 3; &bootloader sits top-left)
 *
 * MAC NOTE: K_CUT/K_COPY/K_PASTE use HID "Keyboard" usages that macOS often
 * ignores. If they don't work, swap them for &kp LG(X) / LG(C) / LG(V).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        qwerty_layer {
            display-name = "QWERTY";
            bindings = <
&none  &kp Q  &kp W  &kp E  &kp R  &kp T          &kp Y  &kp U  &kp I      &kp O    &kp P     &none
&none  &kp A  &kp S  &kp D  &kp F  &kp G          &kp H  &kp J  &kp K      &kp L    &kp SEMI  &none
&none  &kp Z  &kp X  &kp C  &kp V  &kp B          &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &none
                  &kp LCTRL  &kp LGUI  &lt 1 SPACE     &lt 2 ENTER  &kp LSHFT  &kp BSPC
            >;
        };

        sym_nav_layer {
            display-name = "SYM_NAV";
            bindings = <
&none  &kp KP_N1  &kp KP_N2   &kp KP_N3   &kp KP_N4   &kp KP_N5      &kp KP_N6  &kp KP_N7  &kp KP_N8  &kp KP_N9   &kp KP_N0  &none
&none  &kp EXCL   &kp GRAVE   &kp DQT     &kp SQT     &kp AMPS       &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT   &kp ESC    &none
&none  &kp PLUS   &kp EQUAL   &kp UNDER   &kp MINUS   &kp STAR       &kp HASH   &kp DLLR   &kp PRCNT  &kp PIPE    &kp BSLH   &none
                          &kp F3  &kp AT  &kp TAB         &kp TAB  &kp TILDE  &none
            >;
        };

        func_layer {
            display-name = "FUNC";
            bindings = <
&none  &kp F1   &kp F2     &kp F3      &kp F4       &kp F5      &kp F6           &kp F7           &kp F8           &kp F9   &kp F10  &none
&none  &kp LT   &kp LBRC   &kp LBKT    &kp LPAR     &none       &none            &kp RPAR         &kp RBKT         &kp RBRC &kp GT   &none
&none  &kp F11  &kp K_CUT  &kp K_COPY  &kp K_PASTE  &kp AT      &kp LS(LG(N4))   &kp LS(LG(N5))   &kp LG(LC(ESC))  &none    &kp F12  &none
                            &none  &to 3  &none           &none  &to 0  &none
            >;
        };

        colemak_layer {
            display-name = "COLEMAK";
            bindings = <
&bootloader  &kp Q  &kp D  &kp R  &kp W  &kp B          &kp J  &kp F  &kp U      &kp P    &kp SEMI  &none
&none        &kp A  &kp S  &kp H  &kp T  &kp G          &kp Y  &kp N  &kp E      &kp O    &kp I     &none
&none        &kp Z  &kp X  &kp M  &kp C  &kp V          &kp K  &kp L  &kp COMMA  &kp DOT  &kp FSLH  &none
                  &kp LCTRL  &kp LGUI  &kp SPACE       &kp ENTER  &kp LSHFT  &mo 1
            >;
        };
    };
};
